# Configuración con credenciales (no versionar; usar db.example.php)
skillswap/config/db.php

# Archivos generados en tiempo de ejecución (no versionar)
skillswap/uploads/certificates/*
skillswap/assets/img/avatars/*
!skillswap/uploads/certificates/.htaccess
!skillswap/assets/img/avatars/.htaccess

# Respaldos / temporales / paquetes
*.sql.bak
*.tar.gz
*.zip
*.log

